rules_version = '2';

// Firestore security rules for MixRun.
//
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // Per-account progress. Readable and writable only by its owner.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Published "learn more" link corrections, merged over the links baked into
    // the app (see LinkOverridesRepository).
    //
    // World-readable on purpose: most players never sign in, and a fix is only
    // useful if it reaches all of them. The document holds nothing sensitive —
    // public Wikipedia and YouTube URLs.
    //
    // Writes are denied to every client. Edit it in the Firebase console, or
    // from a trusted context using the Admin SDK, which bypasses these rules.
    match /config/links {
      allow read: if true;
      allow write: if false;
    }

    // The newest published build, per platform (see AppUpdateRepository).
    //
    // World-readable for the same reason as the links above: MixRun is
    // side-loaded, so this document is the only way an installed copy learns a
    // new APK exists, and most players never sign in. It holds nothing
    // sensitive — a build number and a public download URL.
    //
    // Writes are denied to every client: a client able to change the download
    // URL could point players at an APK we didn't build. Edit it in the
    // Firebase console, or from a trusted context using the Admin SDK.
    match /config/app_version {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
